# Exact browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178
# Demo org label used by the in-memory prototype.
DEMO_ORG_ID=demo-org
# Reserved for the optional model adapter; model calls are not connected in this prototype.
LLM_TIMEOUT=8
# Optional key presence is reported by readiness; never commit real values.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
